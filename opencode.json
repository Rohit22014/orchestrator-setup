{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-luna",
  "subagent_depth": 1,
  "share": "disabled",
  "instructions": [
    "/home/rohit/photography-portfolio-platform-app/README.md",
    "/home/rohit/photography-portfolio-platform-app/CONTRIBUTING.md",
    "/home/rohit/photography-portfolio-platform-app/docs/project/*.md",
    "/home/rohit/.config/opencode/photography-portfolio-platform-app/AGENTS.md",
    "/home/rohit/.config/opencode/photography-portfolio-platform-app/WORKFLOW.md"
  ],
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
    "skill": {
      "*": "deny"
    },
    "edit": "ask",
    "task": "deny",
    "external_directory": "deny",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "git status*": "allow",
      "git diff": "allow",
      "git diff --check": "allow",
      "git diff --stat": "allow",
      "git diff --name-only": "allow",
      "git diff --cached": "allow",
      "git diff --cached --check": "allow",
      "git diff --cached --stat": "allow",
      "git diff --cached --name-only": "allow",
      "git log": "allow",
      "git log --oneline": "allow",
      "git log --oneline --decorate": "allow",
      "git show": "allow",
      "git show --stat": "allow",
      "git branch --show-current": "allow",
      "git remote *": "deny",
      "git remote -v*": "allow",
      "git reset*": "deny",
      "git clean*": "deny",
      "git checkout --*": "deny",
      "rm *": "deny",
      "sudo *": "deny",
      "git add*": "ask",
      "git commit*": "ask",
      "git push*": "ask"
    }
  }
}
