#!/usr/bin/env bash
set -euo pipefail

readonly photography_app_root="/home/rohit/photography-portfolio-platform-app"
readonly photography_app_config_root="/home/rohit/.config/opencode/photography-portfolio-platform-app"
readonly photography_runtime_supervisor="/home/rohit/.local/bin/photography-runtime-supervisor"
readonly photography_runtime_state_root="/home/rohit/.local/state/opencode-photography-app/runtime-supervisor"

if [[ ! -d "${photography_app_root}/.git" ]]; then
  echo "Implementation repository is not initialized: ${photography_app_root}" >&2
  exit 1
fi

if [[ ! -x "${photography_runtime_supervisor}" ]]; then
  echo "Photography runtime supervisor is unavailable: ${photography_runtime_supervisor}" >&2
  exit 1
fi

export OPENCODE_CONFIG="${photography_app_config_root}/opencode.json"
export OPENCODE_CONFIG_DIR="${photography_app_config_root}"
export OPENCODE_ENABLE_EXA=1
export PHOTOGRAPHY_RUNTIME_SUPERVISOR_MODE="high-confidence-auto-term"
export PHOTOGRAPHY_RUNTIME_SUPERVISOR_STATE="${photography_runtime_state_root}/opencode-$$.json"

cd "${photography_app_root}"

mkdir -p "${photography_runtime_state_root}"
chmod 700 "${photography_runtime_state_root}"
setsid "${photography_runtime_supervisor}" monitor \
  --opencode-pid "$$" \
  --app-root "${photography_app_root}" \
  --state "${PHOTOGRAPHY_RUNTIME_SUPERVISOR_STATE}" \
  </dev/null >/dev/null 2>&1 &

exec /home/rohit/.npm-global/bin/opencode "$@"
