#!/usr/bin/env python3

"""Observe photography OpenCode verifier health and recover proven hangs."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import signal
import subprocess
import sys
import time
from pathlib import Path
from typing import Any


APP_ROOT = Path("/home/rohit/photography-portfolio-platform-app")
STATE_ROOT = Path("/home/rohit/.local/state/opencode-photography-app/runtime-supervisor")
SCHEMA_VERSION = 2
DEFAULT_INTERVAL_SECONDS = 10
IDLE_ALERT_SECONDS = 5 * 60
ABSOLUTE_ALERT_SECONDS = 20 * 60
FAILED_LINGER_SECONDS = 60
COMPLETED_LINGER_SECONDS = 5 * 60
LOG_TAIL_BYTES = 128 * 1024
VERIFY_PATTERN = re.compile(r"scripts/verify-[^\s]*(?:runtime|compose)[^\s]*\.(?:mjs|js)\b")
FAILURE_LINE_PATTERN = re.compile(r"(?:_FAILED|_BLOCKED|_EXCEEDED)\b")
TERMINAL_SUCCESS_PATTERN = re.compile(
    r"(?:_COMPREHENSIVE_PASSED|_LEAK_CHECK_PASS)\b"
)
TICKET_PATTERN = re.compile(r"\b([A-Z]+-\d+)\b")
STOP_REQUESTED = False


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat()


def safe_int(value: str) -> int | None:
    try:
        return int(value)
    except (TypeError, ValueError):
        return None


def process_stat(pid: int) -> dict[str, Any] | None:
    try:
        raw = Path(f"/proc/{pid}/stat").read_text()
    except (FileNotFoundError, PermissionError, ProcessLookupError):
        return None
    close = raw.rfind(")")
    if close < 0:
        return None
    fields = raw[close + 2 :].split()
    if len(fields) < 20:
        return None
    return {
        "state": fields[0],
        "ppid": int(fields[1]),
        "pgid": int(fields[2]),
        "start_ticks": int(fields[19]),
    }


def process_cmdline(pid: int) -> list[str]:
    try:
        data = Path(f"/proc/{pid}/cmdline").read_bytes()
    except (FileNotFoundError, PermissionError, ProcessLookupError):
        return []
    return [part.decode("utf-8", "replace") for part in data.split(b"\0") if part]


def process_cwd(pid: int) -> str | None:
    try:
        return os.readlink(f"/proc/{pid}/cwd")
    except (FileNotFoundError, PermissionError, ProcessLookupError):
        return None


def process_snapshot() -> dict[int, dict[str, Any]]:
    snapshot: dict[int, dict[str, Any]] = {}
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        pid = int(entry.name)
        stat = process_stat(pid)
        if stat is None:
            continue
        snapshot[pid] = {
            "pid": pid,
            **stat,
            "argv": process_cmdline(pid),
            "cwd": process_cwd(pid),
        }
    return snapshot


def descendant_ids(root_pid: int, snapshot: dict[int, dict[str, Any]]) -> set[int]:
    children: dict[int, list[int]] = {}
    for pid, process in snapshot.items():
        children.setdefault(process["ppid"], []).append(pid)
    descendants: set[int] = set()
    pending = list(children.get(root_pid, []))
    while pending:
        pid = pending.pop()
        if pid in descendants:
            continue
        descendants.add(pid)
        pending.extend(children.get(pid, []))
    return descendants


def under_app_root(cwd: str | None, app_root: Path) -> bool:
    if not cwd:
        return False
    try:
        Path(cwd).resolve().relative_to(app_root.resolve())
        return True
    except (OSError, ValueError):
        return False


def ticket_from_cwd(cwd: str | None) -> str | None:
    if not cwd:
        return None
    match = TICKET_PATTERN.search(cwd)
    return match.group(1) if match else None


def find_log_path(
    verifier: dict[str, Any], descendants: list[dict[str, Any]]
) -> Path | None:
    for process in descendants:
        if process["pgid"] != verifier["pgid"]:
            continue
        argv = process["argv"]
        if not argv or Path(argv[0]).name != "tee":
            continue
        for argument in argv[1:]:
            if argument.startswith("-"):
                continue
            candidate = Path(argument)
            if candidate.is_absolute():
                return candidate
    return None


def read_log_health(path: Path | None) -> dict[str, Any]:
    if path is None:
        return {
            "path": None,
            "mtime": None,
            "idle_seconds": None,
            "failure_markers": [],
            "connection_refused_count": 0,
            "unhandled_error": False,
            "terminal_success": False,
        }
    try:
        stat = path.stat()
        with path.open("rb") as handle:
            handle.seek(max(0, stat.st_size - LOG_TAIL_BYTES))
            text = handle.read().decode("utf-8", "replace")
    except (FileNotFoundError, PermissionError, OSError):
        return {
            "path": str(path),
            "mtime": None,
            "idle_seconds": None,
            "failure_markers": [],
            "connection_refused_count": 0,
            "unhandled_error": False,
            "terminal_success": False,
        }
    failure_markers = [
        line.strip()[:500]
        for line in text.splitlines()
        if FAILURE_LINE_PATTERN.search(line)
    ][-10:]
    return {
        "path": str(path),
        "mtime": dt.datetime.fromtimestamp(stat.st_mtime, dt.timezone.utc).isoformat(),
        "idle_seconds": max(0, int(time.time() - stat.st_mtime)),
        "failure_markers": failure_markers,
        "connection_refused_count": text.count("ECONNREFUSED"),
        "unhandled_error": "Unhandled 'error' event" in text,
        "terminal_success": bool(TERMINAL_SUCCESS_PATTERN.search(text)),
    }


def docker_candidates(tickets: set[str]) -> list[dict[str, str]]:
    if not tickets:
        return []
    normalized = {ticket.lower() for ticket in tickets}
    try:
        result = subprocess.run(
            ["docker", "ps", "-a", "--format", "{{json .}}"],
            check=False,
            capture_output=True,
            text=True,
            timeout=10,
        )
    except (FileNotFoundError, subprocess.SubprocessError):
        return []
    candidates: list[dict[str, str]] = []
    for line in result.stdout.splitlines():
        try:
            item = json.loads(line)
        except json.JSONDecodeError:
            continue
        name = str(item.get("Names", ""))
        lowered = name.lower()
        if not name.startswith("photography-"):
            continue
        if not any(ticket in lowered for ticket in normalized):
            continue
        candidates.append(
            {
                "id": str(item.get("ID", "")),
                "name": name,
                "state": str(item.get("State", "")),
                "status": str(item.get("Status", "")),
            }
        )
    return sorted(candidates, key=lambda item: item["name"])


def verifier_command(process: dict[str, Any]) -> str:
    return " ".join(process.get("argv", []))


def is_direct_verifier(process: dict[str, Any]) -> bool:
    argv = process.get("argv", [])
    if not argv:
        return False
    executable = Path(argv[0]).name
    if not (executable == "node" or executable.startswith("node-")):
        return False
    return any(VERIFY_PATTERN.search(argument) for argument in argv[1:])


def select_verifier_processes(
    descendants: list[dict[str, Any]], app_root: Path
) -> list[dict[str, Any]]:
    """Select the executable verifier, not shells whose text embeds its command."""
    candidates = [
        process
        for process in descendants
        if VERIFY_PATTERN.search(verifier_command(process))
        and under_app_root(process.get("cwd"), app_root)
    ]
    selected: list[dict[str, Any]] = []
    groups: dict[int, list[dict[str, Any]]] = {}
    for process in candidates:
        groups.setdefault(process["pgid"], []).append(process)
    for group in groups.values():
        direct = [process for process in group if is_direct_verifier(process)]
        if direct:
            selected.extend(direct)
            continue
        candidate_ids = {process["pid"] for process in group}
        wrapper_ids = {
            process["ppid"]
            for process in group
            if process["ppid"] in candidate_ids
        }
        selected.extend(
            process for process in group if process["pid"] not in wrapper_ids
        )
    return sorted(selected, key=lambda process: process["pid"])


def owned_fingerprint(
    process: dict[str, Any], ticket: str | None, log_path: Path | None
) -> dict[str, Any]:
    return {
        "pid": process["pid"],
        "start_ticks": process["start_ticks"],
        "pgid": process["pgid"],
        "command": verifier_command(process),
        "cwd": process["cwd"],
        "ticket": ticket,
        "log_path": str(log_path) if log_path else None,
        "observed_as_descendant": True,
    }


def matches_owned_fingerprint(
    process: dict[str, Any], owned: dict[str, Any], app_root: Path
) -> bool:
    command = verifier_command(process)
    return bool(
        owned.get("observed_as_descendant")
        and process["pid"] == owned.get("pid")
        and process["start_ticks"] == owned.get("start_ticks")
        and process["pgid"] == owned.get("pgid")
        and command == owned.get("command")
        and VERIFY_PATTERN.search(command)
        and process.get("cwd") == owned.get("cwd")
        and under_app_root(process.get("cwd"), app_root)
        and ticket_from_cwd(process.get("cwd")) == owned.get("ticket")
    )


def verifier_records(
    root_pid: int,
    root_start_ticks: int,
    app_root: Path,
    first_seen: dict[tuple[int, int], float],
    owned_verifiers: dict[tuple[int, int], dict[str, Any]],
) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    snapshot = process_snapshot()
    root = snapshot.get(root_pid)
    if root is None or root["start_ticks"] != root_start_ticks:
        return [], []
    ids = descendant_ids(root_pid, snapshot)
    descendants = [snapshot[pid] for pid in ids if pid in snapshot]
    selected = select_verifier_processes(descendants, app_root)
    selected_keys = {
        (process["pid"], process["start_ticks"]) for process in selected
    }
    for process in selected:
        ticket = ticket_from_cwd(process["cwd"])
        log_path = find_log_path(process, descendants)
        owned_verifiers[(process["pid"], process["start_ticks"])] = owned_fingerprint(
            process, ticket, log_path
        )
    for key, owned in list(owned_verifiers.items()):
        if key in selected_keys:
            continue
        process = snapshot.get(key[0])
        if key[0] in ids:
            # A more precise leaf verifier appeared in the same live tree.
            # Forget any wrapper we may have observed during process startup.
            owned_verifiers.pop(key, None)
            first_seen.pop(key, None)
            continue
        if process is None or not matches_owned_fingerprint(process, owned, app_root):
            owned_verifiers.pop(key, None)
            first_seen.pop(key, None)
            continue
        selected.append(process)
    verifiers: list[dict[str, Any]] = []
    alerts: list[dict[str, Any]] = []
    for process in sorted(selected, key=lambda item: item["pid"]):
        command = verifier_command(process)
        key = (process["pid"], process["start_ticks"])
        started = first_seen.setdefault(key, time.time())
        age_seconds = max(0, int(time.time() - started))
        owned = owned_verifiers[key]
        log_path = Path(owned["log_path"]) if owned.get("log_path") else None
        log = read_log_health(log_path)
        reasons: list[str] = []
        if log["failure_markers"]:
            reasons.append("failure marker observed")
        if log["unhandled_error"]:
            reasons.append("unhandled error observed")
        if log["connection_refused_count"] >= 3:
            reasons.append("repeated connection refusal after cleanup")
        if log["idle_seconds"] is not None and log["idle_seconds"] >= IDLE_ALERT_SECONDS:
            reasons.append("no log progress for at least five minutes")
        if age_seconds >= ABSOLUTE_ALERT_SECONDS:
            reasons.append("verifier has run for at least twenty minutes")
        ticket = ticket_from_cwd(process["cwd"])
        record = {
            "pid": process["pid"],
            "ppid": process["ppid"],
            "pgid": process["pgid"],
            "start_ticks": process["start_ticks"],
            "command": command,
            "cwd": process["cwd"],
            "ticket": ticket,
            "ownership_basis": (
                "exact-descendant"
                if key in selected_keys
                else "tracked-descendant-continuity"
            ),
            "age_seconds": age_seconds,
            "log": log,
            "attention": bool(reasons),
            "attention_reasons": reasons,
        }
        verifiers.append(record)
        if reasons:
            alerts.append(
                {
                    "kind": "verifier_attention",
                    "pid": process["pid"],
                    "ticket": ticket,
                    "reasons": reasons,
                    "observed_at": utc_now(),
                }
            )
    active_keys = {(item["pid"], item["start_ticks"]) for item in verifiers}
    for key in list(first_seen):
        if key not in active_keys:
            first_seen.pop(key, None)
    return sorted(verifiers, key=lambda item: item["pid"]), alerts


def atomic_write_json(path: Path, value: dict[str, Any]) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(path.parent, 0o700)
    temporary = path.with_suffix(path.suffix + f".{os.getpid()}.tmp")
    with temporary.open("w", encoding="utf-8") as handle:
        json.dump(value, handle, indent=2, sort_keys=True)
        handle.write("\n")
    os.chmod(temporary, 0o600)
    os.replace(temporary, path)


def append_log(path: Path, message: str) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(f"{utc_now()} {message}\n")
    os.chmod(path, 0o600)


def state_paths(opencode_pid: int, state_path: str | None) -> tuple[Path, Path]:
    state = Path(state_path) if state_path else STATE_ROOT / f"opencode-{opencode_pid}.json"
    return state, state.with_suffix(".log")


def build_state(
    opencode_pid: int,
    opencode_start_ticks: int,
    supervisor_started_at: str,
    app_root: Path,
    first_seen: dict[tuple[int, int], float],
    actions: list[dict[str, Any]] | None = None,
    owned_verifiers: dict[tuple[int, int], dict[str, Any]] | None = None,
) -> dict[str, Any]:
    root = process_stat(opencode_pid)
    active = root is not None and root["start_ticks"] == opencode_start_ticks
    verifiers: list[dict[str, Any]] = []
    alerts: list[dict[str, Any]] = []
    if active:
        verifiers, alerts = verifier_records(
            opencode_pid,
            opencode_start_ticks,
            app_root,
            first_seen,
            owned_verifiers if owned_verifiers is not None else {},
        )
    tickets = {item["ticket"] for item in verifiers if item["ticket"]}
    return {
        "schema_version": SCHEMA_VERSION,
        "mode": "high-confidence-auto-term",
        "policy": {
            "signals": "exact-verifier-sigterm-only-after-high-confidence-proof",
            "sigkill": "never",
            "docker_mutation": "never",
            "filesystem_cleanup": "never",
        },
        "supervisor_pid": os.getpid(),
        "supervisor_started_at": supervisor_started_at,
        "opencode_pid": opencode_pid,
        "opencode_start_ticks": opencode_start_ticks,
        "opencode_active": active,
        "app_root": str(app_root),
        "updated_at": utc_now(),
        "status": (
            "attention"
            if alerts
            else "verifier-running"
            if verifiers
            else "healthy"
            if active
            else "opencode-exited"
        ),
        "verifiers": verifiers,
        "docker_candidates": docker_candidates(tickets),
        "alerts": alerts,
        "actions": list(actions or [])[-20:],
    }


def stopped_ticket_containers(
    verifier: dict[str, Any], containers: list[dict[str, str]]
) -> list[dict[str, str]] | None:
    ticket = verifier.get("ticket")
    if not ticket:
        return None
    ticket_name = ticket.lower()
    matching = [
        container
        for container in containers
        if ticket_name in container.get("name", "").lower()
    ]
    if not matching:
        return None
    if any(container.get("state", "").lower() == "running" for container in matching):
        return None
    return matching


def high_confidence_proof(
    verifier: dict[str, Any], containers: list[dict[str, str]]
) -> list[str] | None:
    stopped = stopped_ticket_containers(verifier, containers)
    if stopped is None:
        return None
    log = verifier["log"]
    age_seconds = verifier["age_seconds"]
    if (
        age_seconds >= FAILED_LINGER_SECONDS
        and log["failure_markers"]
        and log["connection_refused_count"] >= 3
    ):
        return [
            "terminal failure marker observed",
            "at least three connection refusals observed after failure",
            "verifier lingered for at least sixty seconds",
            "all ticket-matching Docker containers are stopped",
        ]
    if (
        age_seconds >= COMPLETED_LINGER_SECONDS
        and log["terminal_success"]
        and log["idle_seconds"] is not None
        and log["idle_seconds"] >= COMPLETED_LINGER_SECONDS
    ):
        return [
            "terminal success and leak-check marker observed",
            "no log progress for at least five minutes after completion",
            "all ticket-matching Docker containers are stopped",
        ]
    return None


def revalidate_exact_verifier(
    opencode_pid: int,
    opencode_start_ticks: int,
    verifier: dict[str, Any],
    app_root: Path,
    owned_verifiers: dict[tuple[int, int], dict[str, Any]],
) -> str | None:
    snapshot = process_snapshot()
    root = snapshot.get(opencode_pid)
    process = snapshot.get(verifier["pid"])
    if root is None or root["start_ticks"] != opencode_start_ticks:
        return None
    if process is None or process["start_ticks"] != verifier["start_ticks"]:
        return None
    command = verifier_command(process)
    identity_matches = bool(
        VERIFY_PATTERN.search(command)
        and under_app_root(process["cwd"], app_root)
        and process["cwd"] == verifier["cwd"]
        and command == verifier["command"]
        and process["pgid"] == verifier["pgid"]
        and ticket_from_cwd(process["cwd"]) == verifier.get("ticket")
    )
    if not identity_matches:
        return None
    if verifier["pid"] in descendant_ids(opencode_pid, snapshot):
        return "exact-descendant"
    key = (verifier["pid"], verifier["start_ticks"])
    owned = owned_verifiers.get(key)
    if owned and matches_owned_fingerprint(process, owned, app_root):
        return "tracked-descendant-continuity"
    return None


def auto_term_high_confidence_verifiers(
    state: dict[str, Any],
    opencode_start_ticks: int,
    app_root: Path,
    acted: set[tuple[int, int]],
    owned_verifiers: dict[tuple[int, int], dict[str, Any]],
) -> list[dict[str, Any]]:
    actions: list[dict[str, Any]] = []
    for verifier in state["verifiers"]:
        key = (verifier["pid"], verifier["start_ticks"])
        if key in acted:
            continue
        proof = high_confidence_proof(verifier, state["docker_candidates"])
        if proof is None:
            continue
        ownership_basis = revalidate_exact_verifier(
            state["opencode_pid"],
            opencode_start_ticks,
            verifier,
            app_root,
            owned_verifiers,
        )
        if ownership_basis is None:
            actions.append(
                {
                    "kind": "auto-term-aborted",
                    "pid": verifier["pid"],
                    "start_ticks": verifier["start_ticks"],
                    "ticket": verifier.get("ticket"),
                    "result": "identity-or-ownership-drift",
                    "observed_at": utc_now(),
                    "proof": proof,
                }
            )
            acted.add(key)
            continue
        try:
            os.kill(verifier["pid"], signal.SIGTERM)
            result = "sigterm-sent"
        except ProcessLookupError:
            result = "already-exited"
        except PermissionError:
            result = "permission-denied"
        actions.append(
            {
                "kind": "high-confidence-auto-term",
                "pid": verifier["pid"],
                "start_ticks": verifier["start_ticks"],
                "ticket": verifier.get("ticket"),
                "signal": "SIGTERM",
                "result": result,
                "observed_at": utc_now(),
                "ownership_basis": ownership_basis,
                "proof": proof
                + [
                    "exact leaf verifier identity revalidated from original OpenCode ownership"
                ],
            }
        )
        acted.add(key)
    return actions


def stop_handler(_signum: int, _frame: Any) -> None:
    global STOP_REQUESTED
    STOP_REQUESTED = True


def monitor(args: argparse.Namespace) -> int:
    opencode_pid = args.opencode_pid
    initial = process_stat(opencode_pid)
    if initial is None:
        print(f"OpenCode PID does not exist: {opencode_pid}", file=sys.stderr)
        return 2
    opencode_start_ticks = initial["start_ticks"]
    state_path, log_path = state_paths(opencode_pid, args.state)
    started_at = utc_now()
    first_seen: dict[tuple[int, int], float] = {}
    owned_verifiers: dict[tuple[int, int], dict[str, Any]] = {}
    acted: set[tuple[int, int]] = set()
    actions: list[dict[str, Any]] = []
    prior_alert_signature: str | None = None
    signal.signal(signal.SIGTERM, stop_handler)
    signal.signal(signal.SIGINT, stop_handler)
    append_log(
        log_path,
        f"started supervisor_pid={os.getpid()} opencode_pid={opencode_pid} mode=high-confidence-auto-term",
    )
    while not STOP_REQUESTED:
        state = build_state(
            opencode_pid,
            opencode_start_ticks,
            started_at,
            Path(args.app_root),
            first_seen,
            actions,
            owned_verifiers,
        )
        new_actions = auto_term_high_confidence_verifiers(
            state,
            opencode_start_ticks,
            Path(args.app_root),
            acted,
            owned_verifiers,
        )
        if new_actions:
            actions.extend(new_actions)
            state["actions"] = actions[-20:]
            for action in new_actions:
                append_log(log_path, f"action={json.dumps(action, sort_keys=True)}")
        atomic_write_json(state_path, state)
        signature = json.dumps(state["alerts"], sort_keys=True)
        if state["alerts"] and signature != prior_alert_signature:
            append_log(log_path, f"attention alerts={signature}")
        prior_alert_signature = signature
        if not state["opencode_active"]:
            append_log(log_path, "OpenCode exited; supervisor stopping")
            return 0
        time.sleep(args.interval)
    append_log(log_path, "supervisor received stop signal")
    return 0


def load_states(opencode_pid: int | None) -> list[dict[str, Any]]:
    paths = (
        [STATE_ROOT / f"opencode-{opencode_pid}.json"]
        if opencode_pid is not None
        else sorted(STATE_ROOT.glob("opencode-*.json"), key=lambda path: path.stat().st_mtime)
    )
    states: list[dict[str, Any]] = []
    for path in paths:
        try:
            value = json.loads(path.read_text())
        except (FileNotFoundError, PermissionError, json.JSONDecodeError, OSError):
            continue
        current = process_stat(int(value.get("opencode_pid", -1)))
        value["opencode_active_now"] = bool(
            current and current["start_ticks"] == value.get("opencode_start_ticks")
        )
        value["state_path"] = str(path)
        states.append(value)
    return states


def status(args: argparse.Namespace) -> int:
    states = load_states(args.opencode_pid)
    if not states:
        print("No photography runtime supervisor state found.")
        return 1
    if args.json:
        print(json.dumps(states, indent=2, sort_keys=True))
        return 0
    selected = [state for state in states if state["opencode_active_now"]]
    if not selected:
        selected = states[-1:]
    for state in selected:
        print(
            "Photography runtime supervisor: "
            f"{state['status']} ({state['mode']})"
        )
        print(
            f"OpenCode PID {state['opencode_pid']}: "
            f"{'active' if state['opencode_active_now'] else 'exited'}"
        )
        print(f"Supervisor PID: {state['supervisor_pid']}")
        print(f"Updated: {state['updated_at']}")
        for verifier in state.get("verifiers", []):
            print(
                f"Verifier PID {verifier['pid']} ticket={verifier.get('ticket') or '-'} "
                f"age={verifier['age_seconds']}s attention={str(verifier['attention']).lower()}"
            )
            for reason in verifier.get("attention_reasons", []):
                print(f"  - {reason}")
        containers = state.get("docker_candidates", [])
        if containers:
            print("Observed ticket-named Docker candidates:")
            for container in containers:
                print(
                    f"  - {container['id']} {container['name']} "
                    f"{container['state']} {container['status']}"
                )
        print(f"State: {state['state_path']}")
    return 2 if any(state.get("alerts") for state in selected) else 0


def snapshot(args: argparse.Namespace) -> int:
    initial = process_stat(args.opencode_pid)
    if initial is None:
        print(f"PID does not exist: {args.opencode_pid}", file=sys.stderr)
        return 2
    value = build_state(
        args.opencode_pid,
        initial["start_ticks"],
        utc_now(),
        Path(args.app_root),
        {},
        [],
    )
    print(json.dumps(value, indent=2, sort_keys=True))
    return 0


def doctor(_args: argparse.Namespace) -> int:
    synthetic_failed = {
        "ticket": "MEDIA-99",
        "age_seconds": FAILED_LINGER_SECONDS,
        "log": {
            "failure_markers": ["MEDIA99_RUNTIME_SYNTHETIC_FAILED"],
            "connection_refused_count": 3,
            "terminal_success": False,
            "idle_seconds": 0,
        },
    }
    stopped = [
        {
            "id": "synthetic",
            "name": "photography-media-99-redis",
            "state": "exited",
            "status": "Exited (0)",
        }
    ]
    running = [{**stopped[0], "state": "running", "status": "Up"}]
    synthetic_cwd = str(
        APP_ROOT / "tmp/worktrees/MEDIA-99-supervisor-leaf-selection"
    )
    synthetic_shell = {
        "pid": 100,
        "ppid": 10,
        "pgid": 100,
        "start_ticks": 1000,
        "argv": [
            "/bin/bash",
            "-c",
            "node scripts/verify-media-99-runtime.mjs 2>&1 | tee /tmp/media99.log",
        ],
        "cwd": synthetic_cwd,
    }
    synthetic_node = {
        "pid": 101,
        "ppid": 100,
        "pgid": 100,
        "start_ticks": 1001,
        "argv": ["node", "scripts/verify-media-99-runtime.mjs"],
        "cwd": synthetic_cwd,
    }
    selected = select_verifier_processes(
        [synthetic_shell, synthetic_node], APP_ROOT
    )
    owned = owned_fingerprint(
        synthetic_node, "MEDIA-99", Path("/tmp/media99.log")
    )
    reparented_node = {**synthetic_node, "ppid": 999}
    checks = {
        "app_root_exists": APP_ROOT.is_dir(),
        "proc_available": Path("/proc/self/stat").is_file(),
        "self_stat_readable": process_stat(os.getpid()) is not None,
        "mode_high_confidence_auto_term": True,
        "failed_linger_proof_accepts_complete_evidence": high_confidence_proof(
            synthetic_failed, stopped
        )
        is not None,
        "failed_linger_proof_rejects_running_container": high_confidence_proof(
            synthetic_failed, running
        )
        is None,
        "failed_linger_proof_rejects_missing_terminal_marker": high_confidence_proof(
            {
                **synthetic_failed,
                "log": {**synthetic_failed["log"], "failure_markers": []},
            },
            stopped,
        )
        is None,
        "leaf_selection_excludes_shell_wrapper": [
            process["pid"] for process in selected
        ]
        == [synthetic_node["pid"]],
        "tracked_descendant_accepts_exact_reparented_identity": matches_owned_fingerprint(
            reparented_node, owned, APP_ROOT
        ),
        "tracked_descendant_rejects_pid_reuse": not matches_owned_fingerprint(
            {**reparented_node, "start_ticks": 2001}, owned, APP_ROOT
        ),
        "tracked_descendant_rejects_cwd_drift": not matches_owned_fingerprint(
            {**reparented_node, "cwd": "/tmp"}, owned, APP_ROOT
        ),
        "docker_cli_available": any(
            (Path(path) / "docker").is_file()
            for path in os.environ.get("PATH", "").split(os.pathsep)
            if path
        ),
    }
    print(json.dumps(checks, indent=2, sort_keys=True))
    return 0 if all(checks.values()) else 1


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(
        description="Observe photography OpenCode runtime health without mutation"
    )
    subparsers = root.add_subparsers(dest="command", required=True)
    monitor_parser = subparsers.add_parser("monitor")
    monitor_parser.add_argument("--opencode-pid", type=int, required=True)
    monitor_parser.add_argument("--app-root", default=str(APP_ROOT))
    monitor_parser.add_argument("--state")
    monitor_parser.add_argument("--interval", type=int, default=DEFAULT_INTERVAL_SECONDS)
    monitor_parser.set_defaults(handler=monitor)
    status_parser = subparsers.add_parser("status")
    status_parser.add_argument("--opencode-pid", type=int)
    status_parser.add_argument("--json", action="store_true")
    status_parser.set_defaults(handler=status)
    snapshot_parser = subparsers.add_parser("snapshot")
    snapshot_parser.add_argument("--opencode-pid", type=int, required=True)
    snapshot_parser.add_argument("--app-root", default=str(APP_ROOT))
    snapshot_parser.set_defaults(handler=snapshot)
    doctor_parser = subparsers.add_parser("doctor")
    doctor_parser.set_defaults(handler=doctor)
    return root


def main() -> int:
    args = parser().parse_args()
    if hasattr(args, "interval") and args.interval < 2:
        print("Monitor interval must be at least two seconds.", file=sys.stderr)
        return 2
    return int(args.handler(args))


if __name__ == "__main__":
    raise SystemExit(main())
